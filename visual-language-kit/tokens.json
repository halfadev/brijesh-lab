{
  "name": "Brijesh Ramakrishnan Visual Language",
  "theme": "Making sense of complex systems",
  "colors": {
    "heading": "#0A2D5B",
    "body": "#304B69",
    "muted": "#465D79",
    "primary": "#1779CF",
    "sectionTint": "#E4F3FF",
    "border": "#B5D7F2",
    "pageBackground": "#F7FAFC",
    "surface": "#FFFEFA",
    "lavender": "#E2C8F2",
    "mint": "#CDEFD8",
    "yellow": "#FAEAA8",
    "peach": "#FADCC8",
    "rose": "#F2D5DF",
    "paleBlue": "#D9ECFF"
  },
  "geometry": {
    "cornerRadius": "restrained, 12-24px at 1920x1080",
    "connectorWeight": "2-4px at 1920x1080",
    "safeMarginPercent": 7.5,
    "majorElementsMaximum": 8
  },
  "type": {
    "family": "Inter, Arial, Helvetica, sans-serif",
    "titleWeight": 800,
    "bodyWeight": 400,
    "generatedLabelMaximumWords": 3
  },
  "outputs": {
    "horizontal": "1920x1080",
    "horizontalHighResolution": "3840x2160",
    "vertical": "1080x1920",
    "square": "1080x1080"
  },
  "visualModes": [
    "editorial-system-map",
    "notebook-explainer"
  ],
  "avoid": [
    "generic corporate stock photography",
    "robots and glowing brains",
    "dark futuristic dashboards",
    "neon and glassmorphism",
    "gratuitous 3D rendering",
    "dense text",
    "decorative networks without meaning"
  ]
}
