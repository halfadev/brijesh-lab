{
  "name": "brijesh-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "content:build": "node scripts/generate-content-registry.mjs",
    "dev": "npm run content:build && next dev",
    "dev:sites": "npm run content:build && vinext dev",
    "build": "npm run content:build && next build",
    "build:sites": "npm run content:build && vinext build",
    "start": "next start",
    "start:sites": "wrangler dev --config dist/server/wrangler.json",
    "typecheck": "npm run content:build && tsc --noEmit"
  },
  "dependencies": {
    "marked": "^18.0.11",
    "next": "^15.5.24",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-server-dom-webpack": "^19.3.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@types/node": "^22.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.36",
    "typescript": "5.9.3",
    "vinext": "^1.1.0",
    "vite": "^8.3.4",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "source-map-js": "1.2.2"
  },
  "type": "module"
}
