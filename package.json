{
  "name": "brijesh-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "content:build": "node scripts/generate-content-registry.mjs",
    "dev": "npm run content:build && next dev",
    "dev:sites": "npm run content:build && vinext dev",
    "build": "npm run content:build && next build",
    "build:sites": "npm run content:build && vinext build",
    "start": "next start",
    "start:sites": "wrangler dev --config dist/server/wrangler.json",
    "typecheck": "npm run content:build && tsc --noEmit"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "marked": "^18.0.11",
    "next": "^15.5.24",
    "next-mdx-remote": "^6.0.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@types/node": "^22.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "postcss": "8.5.23"
  },
  "type": "module"
}
